$data['tables']['resources']['name'] = "pages_resources";

// MySQL
$data['tables']['resources']['mysql'] = "CREATE TABLE `".TABLE_PREFIX."pages_resources` (
    `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
    `data` LONGTEXT NOT NULL,
    `version` VARCHAR(50) NOT NULL DEFAULT '',
    `checksum` CHAR(64) NOT NULL,
    `dateline` INT UNSIGNED NOT NULL,
    `active` TINYINT(1) NOT NULL DEFAULT 0,
    PRIMARY KEY (`id`),
    KEY `active` (`active`)
) ENGINE=InnoDB;";

// PostgreSQL
$data['tables']['resources']['pgsql'] = "CREATE TABLE ".TABLE_PREFIX."pages_resources (
    id SERIAL PRIMARY KEY,
    data TEXT NOT NULL,
    version VARCHAR(50) NOT NULL DEFAULT '',
    checksum CHAR(64) NOT NULL,
    dateline BIGINT NOT NULL,
    active SMALLINT NOT NULL DEFAULT 0
);

CREATE INDEX ".TABLE_PREFIX."pages_resources_active_idx
ON ".TABLE_PREFIX."pages_resources (active);";

// SQLite
$data['tables']['resources']['sqlite'] = "CREATE TABLE ".TABLE_PREFIX."pages_resources (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    data TEXT NOT NULL,
    version VARCHAR(50) NOT NULL DEFAULT '',
    checksum CHAR(64) NOT NULL,
    dateline INTEGER NOT NULL,
    active INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX ".TABLE_PREFIX."pages_resources_active_idx
ON ".TABLE_PREFIX."pages_resources (active);";

$data['tables']['layout']['name'] = "pages_layout";

// MySQL
$data['tables']['layout']['mysql'] = "CREATE TABLE `".TABLE_PREFIX."pages_layout` (
    `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,
    `page_id` INT UNSIGNED NOT NULL,
    `block_id` INT UNSIGNED NOT NULL,
    `zone` TINYINT UNSIGNED NOT NULL DEFAULT 0,
    `display_order` SMALLINT UNSIGNED NOT NULL DEFAULT 0,
    PRIMARY KEY (`id`),
    KEY `page_id` (`page_id`),
    KEY `block_id` (`block_id`),
    KEY `page_zone_order` (`page_id`, `zone`, `display_order`),
    UNIQUE KEY `page_block_zone` (`page_id`, `block_id`, `zone`)
) ENGINE=InnoDB;";

// PostgreSQL
$data['tables']['layout']['pgsql'] = "CREATE TABLE ".TABLE_PREFIX."pages_layout (
    id BIGSERIAL PRIMARY KEY,
    page_id BIGINT NOT NULL,
    block_id BIGINT NOT NULL,
    zone SMALLINT NOT NULL DEFAULT 0,
    display_order INTEGER NOT NULL DEFAULT 0,
    CONSTRAINT pages_layout_page_block_zone UNIQUE (page_id, block_id, zone)
);";

$data['tables']['layout']['indexes']['pgsql'] = array(
    "CREATE INDEX ".TABLE_PREFIX."pages_layout_page_id_idx ON ".TABLE_PREFIX."pages_layout (page_id)",
