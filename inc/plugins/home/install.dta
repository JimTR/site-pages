    content TEXT NOT NULL,
    block TEXT NOT NULL,
    enabled SMALLINT NOT NULL DEFAULT 0,
    visible VARCHAR(100) NOT NULL
);";

$data['tables']['blocks']['sqlite'] = "CREATE TABLE ".TABLE_PREFIX."pages_blocks (
