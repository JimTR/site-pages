    "CREATE INDEX ".TABLE_PREFIX."pages_layout_page_zone_order_idx ON ".TABLE_PREFIX."pages_layout (page_id, zone, display_order)"
);

// SQLite
$data['tables']['layout']['sqlite'] = "CREATE TABLE ".TABLE_PREFIX."pages_layout (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    page_id INTEGER NOT NULL,
    block_id INTEGER NOT NULL,
